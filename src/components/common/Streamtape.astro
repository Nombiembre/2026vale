---
// Google Drive video embed (URL en formato /preview)

interface Props {
  src: string;
  title?: string;
}

const { src, title = "Video" } = Astro.props as Props;
---

<div class="video-wrapper">
  <iframe
    src={src}
    title={title}
    allow="autoplay; fullscreen"
    loading="lazy"
    frameborder="0"
  ></iframe>
</div>

<style>
  .video-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>