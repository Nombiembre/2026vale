---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Prose from "~/components/common/Prose.astro";
import Title from "~/components/common/Title.astro";
import Layout from "~/layouts/Layout.astro";
import displayDate from "~/utils/displayTime";

export async function getStaticPaths() {
  const posts = await getCollection("diary");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"diary">;
}

const { post } = Astro.props as Partial<Props>;

if (!post) {
  return Astro.rewrite("/404");
}

const { Content } = await render(post);

const { date, cover, text } = post.data;
const dateString = displayDate(date, {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={dateString} noTitle footerText={text}>
  <div class="container space-y-4 pb-20">
    <Title title={dateString} variant="small" />

    {
      cover && (
        <div class="aspect-video max-w-2xl mb-10 relative mx-auto overflow-hidden shadow-lg border-4 border-muted/30">
          <img
            src={cover}
            alt={`Portada del ${dateString}`}
            width="1280"
            height="720"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      )
    }

    <Prose>
      <Content />
    </Prose>
  </div>
</Layout>
