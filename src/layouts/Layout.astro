---
import "../styles/global.css";
import Head from "~/components/meta/Head.astro";
import Header from "~/components/meta/Header.astro";
import Footer from "~/components/meta/Footer.astro";
import Title from "~/components/common/Title.astro";

interface Props {
	title: string;
	subtitle?: string;
	noTitle?: boolean;
	footerText?: string;
}

const { title, subtitle, noTitle, footerText } = Astro.props;
---

<!doctype html>
<html lang="es">
	<Head title={title} />
	<body class="flex flex-col min-h-screen bg-background">
		<Header />
		<main class="container">
			{
				noTitle ? null : (
					<div class="mb-10 text-center">
						<Title title={title} variant="primary" />
						{subtitle && (
							<span class="text-sm md:text-lg text-ink-muted italic">
								{subtitle}
							</span>
						)}
					</div>
				)
			}
			<slot />
		</main>
		<Footer text={footerText} />
		<script>
			// The site is fully static; this keeps the visit notifier alive
			// without forcing every page to render on demand. Send the page path
			// in the body so the endpoint knows where the visit happened.
			const pathname = window.location.pathname;
			const sent = navigator.sendBeacon?.("/api/visit", pathname);
			if (!sent) {
				fetch("/api/visit", {
					method: "POST",
					body: pathname,
					headers: { "Content-Type": "text/plain;charset=UTF-8" },
					keepalive: true,
				}).catch(() => {});
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
